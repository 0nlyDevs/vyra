# Copier en processing/.env puis remplir ; ensuite : docker compose up -d --force-recreate processing.
# Tout le reste a une valeur par défaut (réglages facultatifs : voir le README, « L'IA »).

# Clés des IA : une ou plusieurs par fournisseur, séparées par des virgules. L'ordre est groq, gemini,
# deepseek ; une IA sans clé est sautée, et la suivante prend le relais quand une clé atteint son quota.
# Sans aucune clé, la réponse préparée de chaque consigne s'affiche.
GROQ_API_KEYS=
GEMINI_API_KEYS=
DEEPSEEK_API_KEYS=

# Tavily (https://tavily.com, gratuit) : recherche web des versions d'une information et posts
# Facebook publics du fil. Vide : recherche GDELT, fil sans Facebook.
TAVILY_API_KEY=

# Google Fact Check Tools (facultatif, gratuit) : les vérifications publiées dans le monde.
GOOGLE_FACTCHECK_API_KEY=
