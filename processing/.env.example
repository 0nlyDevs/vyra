# Copier en processing/.env puis remplir ; ensuite : docker compose restart processing.

# Mode de l'IA (dans tous les cas, la réponse préparée s'affiche si aucune IA ne répond) :
#   gemini             Gemini seul (par défaut, rien à installer)
#   gemini-then-local  Gemini, puis Gemma 4 en local (Ollama) si Gemini ne répond pas
#   local              Gemma 4 en local seul, sans wifi
# Vers ou depuis « local » : lancer « make seed » (les vecteurs des deux IA ne se comparent pas).
AI_MODE=gemini

# --- Gemini : clé gratuite sur https://aistudio.google.com/apikey. Vide = réponses de secours.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# Essayés si le premier est saturé (liste JSON) :
# GEMINI_FALLBACK_MODELS=["gemini-flash-latest","gemini-3.1-flash-lite"]
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- IA locale (Ollama) : « ollama pull gemma4:e4b » et « ollama pull embeddinggemma » d'abord.
# LOCAL_AI_URL=http://host.docker.internal:11434/v1
# LOCAL_AI_MODEL=gemma4:e4b
# LOCAL_EMBEDDING_MODEL=embeddinggemma

# true = jamais d'appel à l'IA, toujours les réponses de secours (répéter le plan B).
DEMO_OFFLINE=false
