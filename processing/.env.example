# Copier en processing/.env puis remplir ; ensuite : docker compose restart processing.

# Clé Gemini : https://aistudio.google.com/apikey (gratuite). Vide = réponses de secours.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Clé Tavily : https://tavily.com (gratuite, ~1 000 recherches par mois). Recherche web des
# versions d'une information (presse, forums, Reddit). Vide = recherche GDELT, plus lente.
TAVILY_API_KEY=

# true = jamais d'appel à Gemini, toujours les réponses de secours (répéter le plan B).
DEMO_OFFLINE=false
