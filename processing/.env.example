# Copier en processing/.env puis remplir ; ensuite : docker compose restart processing.

# Les IA distantes, dans l'ordre où elles sont essayées. La première répond ; si elle n'a pas de clé,
# a atteint son quota ou tombe en panne, la suivante prend le relais (puis le local, si le mode le
# veut, puis la réponse préparée). Ordre par défaut : groq, gemini, deepseek.
# AI_PROVIDERS=groq,gemini,deepseek

# Plusieurs clés par fournisseur, séparées par des virgules : quand l'une atteint son quota (erreur
# 429), la suivante prend le relais toute seule. La clé épuisée est mise de côté 60 s (limite de
# débit) ou 1 h (quota du jour, solde épuisé, clé refusée). Une IA sans clé est sautée.
GROQ_API_KEYS=
GEMINI_API_KEYS=
DEEPSEEK_API_KEYS=
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat
# KEY_COOLDOWN_SECONDS=60
# KEY_QUOTA_COOLDOWN_SECONDS=3600
# Groq et DeepSeek ne lisent pas les images ni le son : ces demandes vont à Gemini.

# Mode du local (dans tous les cas, la réponse préparée s'affiche si aucune IA ne répond) :
#   gemini             les IA distantes seules (par défaut, rien à installer)
#   gemini-then-local  les IA distantes, puis Gemma 4 en local (Ollama) si aucune ne répond
#   local              Gemma 4 en local seul, sans wifi
# Vers ou depuis « local » : lancer « make seed » (les vecteurs des deux IA ne se comparent pas).
AI_MODE=gemini

# --- Gemini : clé gratuite sur https://aistudio.google.com/apikey. Une clé ici, ou plusieurs dans
# GEMINI_API_KEYS ci-dessus. Aucune clé nulle part = réponses de secours.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# Essayés si le premier est saturé (liste JSON) :
# GEMINI_FALLBACK_MODELS=["gemini-flash-latest","gemini-3.1-flash-lite"]
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Les vecteurs (recherche par le sens) viennent toujours de Gemini, avec rotation de ses clés.

# --- IA locale (Ollama) : « ollama pull gemma4:e4b » et « ollama pull embeddinggemma » d'abord.
# LOCAL_AI_URL=http://host.docker.internal:11434/v1
# LOCAL_AI_MODEL=gemma4:e4b
# LOCAL_EMBEDDING_MODEL=embeddinggemma

# --- Tavily : https://tavily.com (gratuite, ~1 000 recherches par mois). Recherche web des
# versions d'une information (presse, forums, Reddit), et posts Facebook publics du fil
# d'actualité (2 recherches par heure au plus). Vide = recherche GDELT, fil sans Facebook.
TAVILY_API_KEY=

# --- Google Fact Check Tools (facultatif, gratuit) : clé Google Cloud avec l'API « Fact Check
# Tools » activée. Ajoute les vérifications publiées dans le monde. Vide = rubriques de
# vérification (avec Tavily) et Wikipédia seulement.
GOOGLE_FACTCHECK_API_KEY=

# true = jamais d'appel à l'IA, toujours les réponses de secours (répéter le plan B).
DEMO_OFFLINE=false

# --- En ligne seulement : secret partagé avec le web (même valeur que PROCESSING_TOKEN côté web).
# Les appels sans ce secret sont refusés (sauf /health). Vide sur le PC : pas de contrôle.
# PROCESSING_TOKEN=
