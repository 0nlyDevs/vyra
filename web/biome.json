{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "noProcessEnv": "error",
        "noNonNullAssertion": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/features/landing/galaxy/**"],
      "linter": {
        "rules": {
          "complexity": { "useOptionalChain": "off" },
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off",
            "noArrayIndexKey": "off"
          },
          "style": { "noNonNullAssertion": "off" },
          "a11y": { "useSemanticElements": "off", "noSvgWithoutTitle": "off" }
        }
      }
    },
    {
      "includes": ["src/lib/env.ts", "next.config.ts", "drizzle.config.ts", "scripts/**"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["src/lib/logger.ts", "scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["src/**", "!src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "postgres": "Accès à la base uniquement dans src/server/db.",
                  "drizzle-orm": "Accès à la base uniquement dans src/server (db, dal).",
                  "drizzle-orm/postgres-js": "Accès à la base uniquement dans src/server/db."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/server/*", "@/features/*"],
                    "message": "Les composants partagés restent génériques : ni code serveur, ni import d'une fonctionnalité."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
