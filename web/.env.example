# Utile seulement pour lancer web HORS Docker (make web-local) : copier en web/.env.local.
# Dans Docker, ces valeurs viennent de docker-compose.yml. Le reste a une valeur par défaut
# (réglages facultatifs : voir le README).

# Base Postgres de docker-compose.yml (port 5433 côté PC).
DATABASE_URL=postgres://vyra:vyra@localhost:5433/vyra

# Comptes de démo en un clic (dont un admin) et bouton « Réinitialiser la démo ». Absente : actif
# sur le PC, coupé en production. En ligne, `true` seulement le temps d'une présentation.
# DEMO_MODE=true

# Réglages facultatifs du site (définir leurs vraies valeurs dans le fichier privé ou l’hébergeur).
# PROCESSING_URL=http://127.0.0.1:8000
# PROCESSING_TOKEN=secret-partage-avec-processing
# APP_URL=http://localhost:3000
# RESEND_API_KEY=cle-resend
# MAIL_FROM=Vyra <no-reply@votre-domaine-verifie.example>
# GOOGLE_CLIENT_ID=identifiant-oauth
# GOOGLE_CLIENT_SECRET=secret-oauth
# SEAL_SECRET=graine-privee-au-moins-32-caracteres
# API_CORS_ORIGIN=*

# Docker Compose transmet RESEND_API_KEY depuis le .env RACINE. Une variable vide déjà
# transmise par Compose n’est pas remplacée par web/.env.local. En ligne, utiliser les variables
# de Vercel (web) et Render (processing), puis redéployer les services concernés.
# EMAIL_FROM n’est pas lu : le nom de l’expéditeur est MAIL_FROM.
