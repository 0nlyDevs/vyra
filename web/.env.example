# Utile seulement pour lancer web HORS Docker (make web-local) : copier en web/.env.local.
# Dans Docker, ces valeurs viennent de docker-compose.yml. Le reste a une valeur par défaut
# (réglages facultatifs : voir le README).

# Base Postgres de docker-compose.yml (port 5433 côté PC).
DATABASE_URL=postgres://mindstack:mindstack@localhost:5433/mindstack
