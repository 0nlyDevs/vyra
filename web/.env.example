# Utile seulement pour lancer web HORS Docker (make web-local) : copier en web/.env.local.
# Dans Docker, ces valeurs viennent de docker-compose.yml.

# Base Postgres de docker-compose.yml (port 5433 côté PC).
DATABASE_URL=postgres://mindstack:mindstack@localhost:5433/mindstack
# Service processing de docker-compose.yml.
PROCESSING_URL=http://127.0.0.1:8000
# Nom affiché dans l'interface (à changer une fois le sujet connu).
NEXT_PUBLIC_APP_NAME=MindStack
