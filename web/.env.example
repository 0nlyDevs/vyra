# Utile seulement pour lancer web HORS Docker (make web-local) : copier en web/.env.local.
# Dans Docker, ces valeurs viennent de docker-compose.yml.

# Base Postgres de docker-compose.yml (port 5433 côté PC).
DATABASE_URL=postgres://mindstack:mindstack@localhost:5433/mindstack
# Service processing de docker-compose.yml.
PROCESSING_URL=http://127.0.0.1:8000
# En ligne seulement : même valeur que PROCESSING_TOKEN de processing (vide sur le PC).
# PROCESSING_TOKEN=
# Nom affiché dans l'interface (à changer une fois le sujet connu).
NEXT_PUBLIC_APP_NAME=Vyra

# Adresse de l'application (liens des e-mails, retour de la connexion Google).
APP_URL=http://localhost:3000
# E-mails : Mailpit de docker-compose.yml, visible sur http://localhost:8025.
SMTP_URL=smtp://127.0.0.1:1025

# --- Aussi dans Docker : web lit web/.env.local. Connexion avec Google (facultative, voir README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
