{
  "manifest_version": 3,
  "name": "MindStack · Vérifier ici",
  "version": "0.1.0",
  "description": "Vérifier un texte, un lien ou une image sans quitter la page : affaires déjà jugées, signes d'alerte et vérifications publiées.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Vérifier ici", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
